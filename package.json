{
  "name": "hackwiki",
  "private": true,
  "version": "0.0.3",
  "description": "Hackwiki monorepo for the SDK, CLI, and agent skills",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r run build",
    "changeset": "changeset",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "release": "pnpm build && pnpm lint && pnpm test && changeset publish",
    "test": "pnpm -r run test",
    "version": "changeset version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/hackwiki.git"
  },
  "bugs": {
    "url": "https://github.com/EastSun5566/hackwiki/issues"
  },
  "homepage": "https://github.com/EastSun5566/hackwiki#readme",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260429.1",
    "oxlint": "^1.60.0"
  }
}
