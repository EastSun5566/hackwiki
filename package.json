{
  "name": "hackwiki",
  "version": "0.0.2",
  "description": "A library for maintaining a persistent, LLM-friendly wiki backed by HackMD notes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "test": "node --test",
    "prepublishOnly": "pnpm run build",
    "release": "npx standard-version && git push --follow-tags && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/hackwiki.git"
  },
  "bugs": {
    "url": "https://github.com/EastSun5566/hackwiki/issues"
  },
  "homepage": "https://github.com/EastSun5566/hackwiki#readme",
  "keywords": [
    "hackmd",
    "wiki",
    "llm",
    "knowledge-base",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@hackmd/api": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "oxlint": "^1.60.0",
    "typescript": "^5.4.0"
  }
}
