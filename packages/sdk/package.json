{
  "name": "@hackwiki/sdk",
  "version": "0.0.3",
  "description": "SDK for maintaining a persistent, LLM-friendly wiki backed by HackMD notes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsgo --project tsconfig.build.json",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "test": "node --test test/**/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/hackwiki.git"
  },
  "bugs": {
    "url": "https://github.com/EastSun5566/hackwiki/issues"
  },
  "homepage": "https://github.com/EastSun5566/hackwiki#readme",
  "keywords": [
    "hackmd",
    "wiki",
    "llm",
    "knowledge-base",
    "typescript"
  ],
  "license": "MIT"
}
